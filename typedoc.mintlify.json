{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["index.d.ts"],
  "out": "docs",
  "readme": "README.md",
  "name": "@simular-ai/simulang-js",
  "includeVersion": true,
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-frontmatter"],
  "outputFileStrategy": "members",
  "fileExtension": ".mdx",
  "entryFileName": "index",
  "mergeReadme": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "indexFormat": "table"
}
